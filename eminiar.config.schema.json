{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "routing": {
      "default": {},
      "type": "object",
      "properties": {
        "mode": {
          "default": "auto",
          "type": "string",
          "enum": [
            "off",
            "annotate",
            "enforce",
            "auto"
          ]
        },
        "deferToContextMode": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "sandbox": {
      "default": {},
      "type": "object",
      "properties": {
        "timeoutMs": {
          "default": 60000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputBytes": {
          "default": 2097152,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "indexThreshold": {
          "default": 5120,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "envAllow": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disabledLanguages": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "search": {
      "default": {},
      "type": "object",
      "properties": {
        "defaultLimit": {
          "default": 5,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "defaultMaxTokens": {
          "default": 2000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "embeddings": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "model": {
          "default": "Xenova/bge-small-en-v1.5",
          "type": "string"
        },
        "dims": {
          "default": 384,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "graph": {
      "default": {},
      "type": "object",
      "properties": {
        "include": {
          "default": [
            "**/*.ts",
            "**/*.tsx",
            "**/*.js",
            "**/*.jsx",
            "**/*.mjs",
            "**/*.cjs",
            "**/*.py",
            "**/*.go",
            "**/*.php"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/.git/**",
            "**/coverage/**",
            "**/*.d.ts",
            "**/.venv/**",
            "**/venv/**",
            "**/__pycache__/**",
            "**/site-packages/**",
            "**/vendor/**",
            "**/*.min.js",
            "**/*.blade.php"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "git": {
      "default": {},
      "type": "object",
      "properties": {
        "maxCommits": {
          "default": 3000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "index": {
      "default": {},
      "type": "object",
      "properties": {
        "docs": {
          "default": [
            "**/*.md",
            "**/*.mdx"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "permissions": {
      "default": {},
      "type": "object",
      "properties": {
        "extraDeny": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "code": {
      "default": {},
      "type": "object",
      "properties": {
        "backend": {
          "default": "tree-sitter",
          "type": "string",
          "enum": [
            "tree-sitter"
          ]
        }
      }
    },
    "memories": {
      "default": {},
      "type": "object",
      "properties": {
        "dir": {
          "default": ".eminiar/memories",
          "type": "string"
        }
      }
    },
    "recall": {
      "default": {},
      "type": "object",
      "properties": {
        "onPrompt": {
          "default": true,
          "type": "boolean"
        },
        "onFile": {
          "default": true,
          "type": "boolean"
        },
        "onAgent": {
          "default": true,
          "type": "boolean"
        },
        "onCommit": {
          "default": true,
          "type": "boolean"
        },
        "onError": {
          "default": true,
          "type": "boolean"
        },
        "onWeb": {
          "default": true,
          "type": "boolean"
        },
        "maxMemories": {
          "default": 3,
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "maxDocs": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "repeatAfter": {
          "default": 10,
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "docs": {
      "default": {},
      "type": "object",
      "properties": {
        "manifest": {
          "default": ".eminiar/docs.json",
          "type": "string"
        },
        "ttlHours": {
          "default": 168,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crawl": {
          "default": {},
          "type": "object",
          "properties": {
            "depth": {
              "default": 1,
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "maxPages": {
              "default": 8,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 200
            },
            "maxPageBytes": {
              "default": 122880,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "api": {
              "default": {},
              "type": "object",
              "properties": {
                "depth": {
                  "default": 2,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "maxPages": {
                  "default": 150,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 200
                }
              }
            }
          }
        },
        "embed": {
          "default": false,
          "type": "boolean"
        },
        "discover": {
          "default": {},
          "type": "object",
          "properties": {
            "includeDev": {
              "default": false,
              "type": "boolean"
            },
            "subprojects": {
              "default": true,
              "type": "boolean"
            }
          }
        },
        "catalog": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "urls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "npm": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pypi": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "go": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "image": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tier": {
                "type": "string",
                "enum": [
                  "service",
                  "infra",
                  "library"
                ]
              },
              "crawl": {
                "type": "object",
                "properties": {
                  "depth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  "maxPages": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 200
                  }
                }
              }
            },
            "required": [
              "id",
              "title",
              "urls"
            ]
          }
        }
      }
    }
  },
  "title": "eminiar.config.json",
  "description": "Per-project eminiar settings. Commit this file so teammates share the same behaviour."
}
