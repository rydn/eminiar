#!/bin/sh
# Hook entry shim. Node and package-root resolution live in _resolve.sh.
# A hook must never block Claude: if nothing can run, print an empty JSON object.
EM_ENTRY=hook
. "$(dirname "$0")/_resolve.sh"
# Swarm enforcement fails closed: when nothing can run, an Agent/Task call in a project whose
# .eminiar/swarm.yaml says `enforce: true` is denied. Reads stdin only here; every other call
# (and every other project) gets the empty answer below.
swarm_gate() {
  case " $* " in *" cursor "*) return 0 ;; esac
  payload=$(cat 2>/dev/null) || return 0
  case "$payload" in *'"PreToolUse"'*) ;; *) return 0 ;; esac
  printf '%s' "$payload" | grep -Eq '"tool_name"[[:space:]]*:[[:space:]]*"(Agent|Task)"' || return 0
  # Payloads with "agent_id" (a call made inside a subagent) are denied too: the Node path
  # allows nested calls only for allow-listed agents, and this shim cannot read allowed_agents,
  # so a nested call gets the same deny text as a main-session one.
  # Root order matches the hooks: CLAUDE_PROJECT_DIR (set by Claude Code per hook command)
  # before EMINIAR_PROJECT_ROOT (may be inherited from an outer session).
  root="${CLAUDE_PROJECT_DIR:-${EMINIAR_PROJECT_ROOT:-$PWD}}"
  # Walk up to the first directory with a project marker (src/project.ts ROOT_MARKERS), else
  # stay on the start dir, so this checks the root resolveProjectRoot would.
  d=$root
  while :; do
    for m in .git package.json pnpm-workspace.yaml go.mod Cargo.toml pyproject.toml; do
      [ -e "$d/$m" ] && break 2
    done
    p=${d%/*}
    [ -n "$p" ] || p=/
    [ "$p" != "$d" ] || { d=$root; break; }
    d=$p
  done
  root=$d
  main=
  # A `claude --worktree` session: .git is a file ("gitdir: <main>/.git/worktrees/<n>"), and the
  # uncommitted swarm file lives in the main checkout. Follow gitdir -> commondir to it. A .git
  # file without a gitdir line, or a gitdir without commondir (a submodule), is not followed.
  if [ -f "$root/.git" ]; then
    cr=$(printf '\r')
    gd=$(grep -m1 '^gitdir:' "$root/.git" 2>/dev/null)
    gd=${gd#gitdir:}
    gd=${gd# }
    gd=${gd%"$cr"}
    if [ -n "$gd" ]; then
      case "$gd" in /*) ;; *) gd="$root/$gd" ;; esac
      cdir=
      [ -f "$gd/commondir" ] && read -r cdir < "$gd/commondir"
      cdir=${cdir%"$cr"}
      if [ -n "$cdir" ]; then
        case "$cdir" in /*) ;; *) cdir="$gd/$cdir" ;; esac
        main=$(cd "$cdir/.." 2>/dev/null && pwd)
        [ "$main" = "$root" ] && main=
      fi
    fi
  fi
  # The same rule as enforceIntent (src/swarm/config.ts): top-level `enforce: true|True|TRUE`
  # (plain or quoted key, BOM, CRLF, space before the colon, trailing comment), and not
  # `enabled: false|False|FALSE`. Flow-style or indented documents are not recognised here; a
  # parsing Node reader decides those.
  bom=$(printf '\357\273\277')
  tail='[[:space:]]*:[[:space:]]+'
  end='([[:space:]]+#.*)?[[:space:]]*$'
  for r in "$root" "$main"; do
    [ -n "$r" ] || continue
    for f in "$r/.eminiar/swarm.yaml" "$r/.eminiar/swarm.yml"; do
      [ -f "$f" ] || continue
      grep -Eq "^($bom)?(enforce|\"enforce\"|'enforce')${tail}(true|True|TRUE)${end}" "$f" 2>/dev/null || return 0
      grep -Eq "^($bom)?(enabled|\"enabled\"|'enabled')${tail}(false|False|FALSE)${end}" "$f" 2>/dev/null && return 0
      echo '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"eminiar swarm enforcement: eminiar'"'"'s hook cannot run (no Node.js or no installed copy; npx eminiar install fixes it), so this subagent is denied. Do the work in this session, or ask the user to fix the install or set enforce: false in .eminiar/swarm.yaml."}}'
      return 1
    done
  done
  return 0
}
# --gate: decide-only mode for a project-level onFailure:"block" entry. Nothing to run means
# failure (exit 1), so that entry blocks; the swarm_gate fallback below is for the plugin hook.
case " $* " in *" --gate "*) EM_GATE=1 ;; *) EM_GATE= ;; esac
if [ ! -x "$NODE" ]; then
  echo "eminiar hook: no node binary found (run: npx eminiar install)" >&2
  [ -n "$EM_GATE" ] && exit 1
  swarm_gate "$@" && echo '{}'
  exit 0
fi
if [ -z "$RUN" ]; then
  echo "eminiar hook: $DIR cannot run (no dist/hook.js or node_modules) and no stable copy is pinned (run: npx eminiar install)" >&2
  [ -n "$EM_GATE" ] && exit 1
  swarm_gate "$@" && echo '{}'
  exit 0
fi
# --deadline <seconds>: a hard stop for hooks that block the user (UserPromptSubmit). Node's own
# soft budget cannot interrupt a synchronous SQLite call, and Claude Code throws a killed hook's
# output away, so a watchdog kills node a little before Claude Code would. The kill prints
# nothing: an empty stdout with exit 0 is a valid "no answer" for the hook, whereas a `{}` could
# follow an answer node had already half written. A non-integer value is ignored (plain exec).
EM_DEADLINE=
em_next=
for em_arg in "$@"; do
  if [ -n "$em_next" ]; then
    case "$em_arg" in
      '' | *[!0-9]*) ;;
      *) EM_DEADLINE=$em_arg ;;
    esac
    em_next=
  elif [ "$em_arg" = "--deadline" ]; then
    em_next=1
  fi
done
if [ -z "$EM_DEADLINE" ] || [ "$EM_DEADLINE" -le 0 ] || [ -n "$EM_GATE" ]; then
  exec "$NODE" "$RUN/dist/hook.js" "$@"
fi
# A background command gets /dev/null as stdin, and node reads the payload there. dash, ksh and
# busybox ash apply that default BEFORE the command's own redirections, so `<&0` would dup
# /dev/null; copy stdin to fd 3 first and hand node fd 3 as stdin. (Not a `{ ...; } 3<&0` group:
# under ksh the shim's wait then returns at once and node is orphaned.)
exec 3<&0
# The watchdog creates this file just before its kill -9, so a deadline kill is told apart from any
# other SIGKILL (the OOM killer) and from shells that report a signal death as 256+n (ksh93: 265).
em_mark="${TMPDIR:-/tmp}/em-hook.$$"
if [ -e "$em_mark" ] || [ -L "$em_mark" ]; then rm -f "$em_mark" 2>/dev/null; fi
"$NODE" "$RUN/dist/hook.js" "$@" <&3 3<&- &
em_pid=$!
exec 3<&-
# The watchdog holds none of Claude Code's pipes, or the hook would not end when node does.
(
  trap 'kill "$em_sp" 2>/dev/null; exit 0' TERM
  sleep "$EM_DEADLINE" &
  em_sp=$!
  if wait "$em_sp"; then
    # noclobber: an existing file or symlink at this path is never written through. The marker is
    # created only here, with shell builtins, so a normal run costs no extra process.
    set -C
    : > "$em_mark"
    kill -9 "$em_pid" 2>/dev/null
  fi
) </dev/null >/dev/null 2>&1 &
em_wd=$!
wait "$em_pid" 2>/dev/null
em_rc=$?
kill "$em_wd" 2>/dev/null
em_fired=
if [ -e "$em_mark" ]; then
  em_fired=1
  rm -f "$em_mark"
fi
# The watchdog's kill: answer with nothing and exit 0. Any other status, a foreign SIGKILL
# included, is node's own (a script that throws at load, say ERR_DLOPEN_FAILED, exits 1) and is passed on, as plain exec
# would, so Claude Code shows the hook error; it is also logged, since stderr is easy to miss.
if [ -n "$em_fired" ]; then
  printf '%s error UserPromptSubmit: em-hook stopped node at the %s s deadline; the prompt went on without eminiar context\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$EM_DEADLINE" >> "$EM_HOME/hook.log" 2>/dev/null
  exit 0
fi
if [ "$em_rc" -ne 0 ]; then
  printf '%s error UserPromptSubmit: node exited with status %s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$em_rc" >> "$EM_HOME/hook.log" 2>/dev/null
fi
exit "$em_rc"
