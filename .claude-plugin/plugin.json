{
  "name": "eminiar",
  "displayName": "Eminiar",
  "version": "0.10.1",
  "description": "Local-first context, memory and knowledge graph for Claude Code: sandboxed execution, FTS5 + vector search, session continuity, code graph.",
  "author": {
    "name": "Ryan Dick"
  },
  "license": "MIT",
  "keywords": [
    "context",
    "memory",
    "search",
    "sandbox",
    "knowledge-graph"
  ],
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "eminiar": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/em-server",
      "args": [],
      "env": {
        "EMINIAR_PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}",
        "EMINIAR_PLUGIN_DATA": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
