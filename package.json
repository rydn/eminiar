{
  "name": "eminiar",
  "version": "0.1.3",
  "description": "Local-first context, memory and knowledge-graph plugin for Claude Code. Sandboxed execution, FTS5 + vector search, session continuity, and a code graph — nothing leaves your machine.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryandick/eminiar"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "context-window",
    "fts5",
    "sqlite-vec",
    "knowledge-graph",
    "tree-sitter",
    "sandbox"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "eminiar": "./bin/eminiar"
  },
  "files": [
    "dist",
    "bin",
    "hooks",
    "skills",
    ".claude-plugin",
    "vendor",
    "queries",
    "eminiar.config.schema.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-grammars.mjs && tsx scripts/gen-schema.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "validate": "claude plugin validate .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.12",
    "sqlite-vec": "^0.1.9",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "web-tree-sitter": "^0.27.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.5",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
