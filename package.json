{
  "name": "eminiar",
  "version": "0.12.0",
  "description": "Local-first context, memory and knowledge-graph plugin for Claude Code and Cursor. Sandboxed execution, FTS5 + vector search, session continuity, and a code graph — nothing leaves your machine.",
  "type": "module",
  "license": "MIT",
  "author": "Ryan Dick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rydn/eminiar.git"
  },
  "homepage": "https://github.com/rydn/eminiar#readme",
  "bugs": {
    "url": "https://github.com/rydn/eminiar/issues"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "mcp",
    "context-window",
    "fts5",
    "sqlite-vec",
    "knowledge-graph",
    "tree-sitter",
    "sandbox",
    "cursor"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "eminiar": "bin/eminiar"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "bin",
    "hooks",
    "skills",
    ".claude-plugin",
    ".cursor-plugin",
    "rules",
    "vendor",
    "eminiar.config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsup --config tsup.web.config.ts && node scripts/copy-grammars.mjs && tsx scripts/gen-schema.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node scripts/bench-hotpath.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "validate": "claude plugin validate .",
    "prepack": "npm run build",
    "version": "node scripts/sync-plugin-version.mjs && git add .claude-plugin/plugin.json .cursor-plugin/plugin.json",
    "build:ui": "tsup --config tsup.web.config.ts",
    "dev:ui": "tsup --config tsup.web.config.ts --watch",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.12",
    "sqlite-vec": "^0.1.9",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "web-tree-sitter": "^0.27.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/turndown": "^5.0.5",
    "d3-force": "^3.0.0",
    "marked": "^18.1.1",
    "preact": "^10.29.8",
    "prismjs": "^1.30.0",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-typescript": "^0.23.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
